# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox REST app — developer.paypal.com → Apps & Credentials (Sandbox).
# Owner must be a US sandbox *business* account, with the app's "Invoicing" and
# "Transaction search" features enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Sandbox *personal* (buyer) account email — the "client" who receives invoices
PAYPAL_SANDBOX_BUYER_EMAIL=

# Google Gemini — aistudio.google.com → Get API key (free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash, falling back to gemini-3.8-flash)
AI_MODEL=
AI_FALLBACK_MODEL=
