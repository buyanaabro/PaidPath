# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox REST app — developer.paypal.com → Apps & Credentials (Sandbox).
# Owner must be a US sandbox *business* account, with the app's "Invoicing" and
# "Transaction search" features enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Sandbox *personal* (buyer) account email — the "client" who receives invoices
PAYPAL_SANDBOX_BUYER_EMAIL=

# Google Gemini — aistudio.google.com → Get API key (free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash, falling back to gemini-3.8-flash,
# then gemini-3.5-flash-lite)
AI_MODEL=
AI_FALLBACK_MODEL=

# Ops Copilot (optional)
# live (default) | record (also saves responses to fixtures/copilot.json) | replay (no Gemini calls)
COPILOT_MODE=
# Requests per visitor per window, "<count>/<seconds>" (default 10/600)
COPILOT_RATE_LIMIT=
# Copilot requests per model per day (default 16, below the ~20/day free tier so plan
# generation and invoice notes keep some quota)
COPILOT_MODEL_DAILY_CAP=
